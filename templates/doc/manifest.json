{
  "name": "doc",
  "shape": "doc",
  "summary": "Prose rendered legibly: a readme, a reference, a how-to. Reading-first, nothing to decode or decide.",
  "intents": ["readme", "reference", "how-to guide", "make this readable", "plain document", "documentation", "manual", "notes"],
  "not_for": ["data", "persuade", "decision"],
  "content_types": ["markdown", "html"],
  "slots": [
    {"name": "title", "says": "what this is", "required": true},
    {"name": "lede", "says": "one paragraph: who it is for and what they get"},
    {"name": "section", "says": "the first section's heading", "required": true},
    {"name": "body", "says": "the section's prose", "required": true}
  ],
  "finish_line": [
    {"id": "title", "kind": "title", "says": "it has a title"},
    {"id": "sections", "kind": "heading", "level": 2, "min": 1, "says": "the prose sits under at least one H2 section"},
    {"id": "no_scripts", "kind": "no_external", "texts": ["script"], "says": "no script from another host: a doc has nothing to run"},
    {"id": "no_emoji", "kind": "no_emoji", "says": "no emoji"},
    {"id": "filled", "kind": "no_slots", "says": "every slot filled"},
    {"id": "nothing_to_decide", "kind": "manual", "says": "reads top to bottom with nothing to decode or decide"}
  ]
}
